rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny-all catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation for Company Profile
    function isValidCompany(data) {
      return data.id is string && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && (!('code' in data) || data.code == null || (data.code is string && data.code.size() <= 30))
        && (!('tagline' in data) || data.tagline == null || (data.tagline is string && data.tagline.size() <= 300))
        && (!('currency' in data) || data.currency == null || (data.currency is string && data.currency.size() <= 20))
        && (!('taxId' in data) || data.taxId == null || (data.taxId is string && data.taxId.size() <= 50))
        && (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 100))
        && (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 50))
        && (!('address' in data) || data.address == null || (data.address is string && data.address.size() <= 300))
        && (!('color' in data) || data.color == null || (data.color is string && data.color.size() <= 50))
        && (!('isDefault' in data) || data.isDefault is bool)
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50
        && (!('userId' in data) || data.userId == null || (data.userId is string && data.userId.size() <= 128));
    }

    // Validation for Stock Item with modification attribution
    function isValidStockItem(data) {
      return data.id is string && isValidId(data.id)
        && data.itemName is string && data.itemName.size() >= 1 && data.itemName.size() <= 200
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 50
        && data.quantity is number && data.quantity >= 0
        && data.lowStockThreshold is number && data.lowStockThreshold >= 0
        && (!('productionDate' in data) || data.productionDate == null || (data.productionDate is string && data.productionDate.size() <= 30))
        && (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 2000))
        && (!('tags' in data) || data.tags == null || (data.tags is list))
        && (!('companyId' in data) || data.companyId == null || (data.companyId is string && data.companyId.size() <= 128))
        && (!('companyName' in data) || data.companyName == null || (data.companyName is string && data.companyName.size() <= 200))
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50
        && (!('createdByName' in data) || data.createdByName == null || (data.createdByName is string && data.createdByName.size() <= 100))
        && (!('createdByEmail' in data) || data.createdByEmail == null || (data.createdByEmail is string && data.createdByEmail.size() <= 100))
        && (!('lastModifiedByName' in data) || data.lastModifiedByName == null || (data.lastModifiedByName is string && data.lastModifiedByName.size() <= 100))
        && (!('lastModifiedByEmail' in data) || data.lastModifiedByEmail == null || (data.lastModifiedByEmail is string && data.lastModifiedByEmail.size() <= 100))
        && (!('userId' in data) || data.userId == null || (data.userId is string && data.userId.size() <= 128));
    }

    // Validation for Stock Unit
    function isValidStockUnit(data) {
      return data.id is string && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 50
        && (!('code' in data) || data.code == null || (data.code is string && data.code.size() <= 20))
        && (!('isDefault' in data) || data.isDefault is bool)
        && (!('companyId' in data) || data.companyId == null || (data.companyId is string && data.companyId.size() <= 128))
        && (!('userId' in data) || data.userId == null || (data.userId is string && data.userId.size() <= 128));
    }

    // Validation for Stock Label & Tag
    function isValidStockTag(data) {
      return data.id is string && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && (!('color' in data) || data.color == null || (data.color is string && data.color.size() <= 50))
        && (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 200))
        && (!('isDefault' in data) || data.isDefault is bool)
        && (!('userId' in data) || data.userId == null || (data.userId is string && data.userId.size() <= 128));
    }

    function isValidStockLabel(data) {
      return isValidStockTag(data);
    }

    // Validation for Audit Log with performer attribution
    function isValidAuditLog(data) {
      return data.id is string && isValidId(data.id)
        && data.timestamp is string && data.timestamp.size() <= 60
        && data.action is string && data.action.size() >= 1 && data.action.size() <= 60
        && (!('summary' in data) || data.summary == null || (data.summary is string && data.summary.size() <= 500))
        && (!('details' in data) || data.details == null || (data.details is string && data.details.size() <= 5000))
        && (!('itemId' in data) || data.itemId == null || (data.itemId is string && data.itemId.size() <= 128))
        && (!('itemName' in data) || data.itemName == null || (data.itemName is string && data.itemName.size() <= 300))
        && (!('unit' in data) || data.unit == null || (data.unit is string && data.unit.size() <= 50))
        && (!('previousQuantity' in data) || data.previousQuantity == null || data.previousQuantity is number)
        && (!('newQuantity' in data) || data.newQuantity == null || data.newQuantity is number)
        && (!('delta' in data) || data.delta == null || data.delta is number)
        && (!('performedBy' in data) || data.performedBy == null || (data.performedBy is string && data.performedBy.size() <= 120))
        && (!('userEmail' in data) || data.userEmail == null || (data.userEmail is string && data.userEmail.size() <= 120))
        && (!('userPhotoURL' in data) || data.userPhotoURL == null || (data.userPhotoURL is string && data.userPhotoURL.size() <= 1000))
        && (!('companyId' in data) || data.companyId == null || (data.companyId is string && data.companyId.size() <= 128))
        && (!('companyName' in data) || data.companyName == null || (data.companyName is string && data.companyName.size() <= 200))
        && (!('userId' in data) || data.userId == null || (data.userId is string && data.userId.size() <= 128));
    }

    // Validation for User Settings
    function isValidUserSetting(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.confirmOnDelete is bool
        && (!('operatorName' in data) || data.operatorName == null || (data.operatorName is string && data.operatorName.size() <= 100))
        && (!('activeCompanyId' in data) || data.activeCompanyId == null || (data.activeCompanyId is string && data.activeCompanyId.size() <= 128))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Validation for Delivery Challan
    function isValidDeliveryChallan(data) {
      return data.id is string && isValidId(data.id)
        && data.challanNumber is string && data.challanNumber.size() >= 1 && data.challanNumber.size() <= 80
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 200
        && data.date is string && data.date.size() <= 60
        && data.dispatchedByName is string && data.dispatchedByName.size() <= 120
        && (!('dispatchedByEmail' in data) || data.dispatchedByEmail == null || (data.dispatchedByEmail is string && data.dispatchedByEmail.size() <= 120))
        && (!('items' in data) || data.items == null || (data.items is list))
        && data.totalItems is number && data.totalItems >= 1
        && data.totalQuantity is number && data.totalQuantity > 0
        && (!('poNumber' in data) || data.poNumber == null || (data.poNumber is string && data.poNumber.size() <= 100))
        && (!('invoiceNumber' in data) || data.invoiceNumber == null || (data.invoiceNumber is string && data.invoiceNumber.size() <= 100))
        && (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 2000))
        && (!('deliveryAddress' in data) || data.deliveryAddress == null || (data.deliveryAddress is string && data.deliveryAddress.size() <= 500))
        && (!('vehicleNumber' in data) || data.vehicleNumber == null || (data.vehicleNumber is string && data.vehicleNumber.size() <= 100))
        && (!('status' in data) || data.status == null || (data.status is string && data.status.size() <= 50))
        && (!('companyName' in data) || data.companyName == null || (data.companyName is string && data.companyName.size() <= 200))
        && (!('companyAddress' in data) || data.companyAddress == null || (data.companyAddress is string && data.companyAddress.size() <= 300))
        && (!('companyPhone' in data) || data.companyPhone == null || (data.companyPhone is string && data.companyPhone.size() <= 50))
        && (!('companyEmail' in data) || data.companyEmail == null || (data.companyEmail is string && data.companyEmail.size() <= 100))
        && data.createdAt is string && data.createdAt.size() <= 60
        && (!('userId' in data) || data.userId == null || (data.userId is string && data.userId.size() <= 128));
    }

    // Validation for Goods Receipt / Inward Delivery Challan
    function isValidGoodsReceipt(data) {
      return data.id is string && isValidId(data.id)
        && data.receiptNumber is string && data.receiptNumber.size() >= 1 && data.receiptNumber.size() <= 80
        && data.vendorName is string && data.vendorName.size() >= 1 && data.vendorName.size() <= 200
        && data.date is string && data.date.size() <= 60
        && data.receivedByName is string && data.receivedByName.size() <= 120
        && (!('receivedByEmail' in data) || data.receivedByEmail == null || (data.receivedByEmail is string && data.receivedByEmail.size() <= 120))
        && (!('items' in data) || data.items == null || (data.items is list))
        && data.totalItems is number && data.totalItems >= 0
        && data.totalQuantity is number && data.totalQuantity >= 0
        && (!('vendorInvoiceNumber' in data) || data.vendorInvoiceNumber == null || (data.vendorInvoiceNumber is string && data.vendorInvoiceNumber.size() <= 100))
        && (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 2000))
        && (!('status' in data) || data.status == null || (data.status is string && data.status.size() <= 50))
        && data.createdAt is string && data.createdAt.size() <= 60
        && (!('userId' in data) || data.userId == null || (data.userId is string && data.userId.size() <= 128));
    }

    // Validation for Customer Party Profile
    function isValidCustomer(data) {
      return data.id is string && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && (!('contactPerson' in data) || data.contactPerson == null || (data.contactPerson is string && data.contactPerson.size() <= 150))
        && (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 60))
        && (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 120))
        && (!('address' in data) || data.address == null || (data.address is string && data.address.size() <= 500))
        && (!('city' in data) || data.city == null || (data.city is string && data.city.size() <= 100))
        && (!('taxNumber' in data) || data.taxNumber == null || (data.taxNumber is string && data.taxNumber.size() <= 80))
        && (!('partyType' in data) || data.partyType == null || (data.partyType is string && data.partyType.size() <= 50))
        && (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 2000))
        && (!('status' in data) || data.status == null || (data.status is string && data.status.size() <= 30))
        && (!('isDefault' in data) || data.isDefault is bool)
        && data.createdAt is string && data.createdAt.size() <= 60
        && data.updatedAt is string && data.updatedAt.size() <= 60
        && (!('userId' in data) || data.userId == null || (data.userId is string && data.userId.size() <= 128));
    }

    // 0. Shared Companies collection: Collaborative multi-company profiles
    match /companies/{companyId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn()
        && isValidId(companyId)
        && incoming().id == companyId
        && isValidCompany(incoming());

      allow update: if isSignedIn()
        && isValidId(companyId)
        && incoming().id == existing().id
        && isValidCompany(incoming());

      allow delete: if isSignedIn()
        && isValidId(companyId);
    }

    // 0b. Shared Delivery Challans collection
    match /delivery_challans/{challanId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn()
        && isValidId(challanId)
        && incoming().id == challanId
        && isValidDeliveryChallan(incoming());

      allow update: if isSignedIn()
        && isValidId(challanId)
        && incoming().id == existing().id
        && isValidDeliveryChallan(incoming());

      allow delete: if isSignedIn()
        && isValidId(challanId);
    }

    // 0c. Shared Goods Receipts & Inward Delivery Challans collection
    match /goods_receipts/{receiptId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn()
        && isValidId(receiptId)
        && incoming().id == receiptId
        && isValidGoodsReceipt(incoming());

      allow update: if isSignedIn()
        && isValidId(receiptId)
        && incoming().id == existing().id
        && isValidGoodsReceipt(incoming());

      allow delete: if isSignedIn()
        && isValidId(receiptId);
    }

    // 0d. Shared Customer Parties collection: Collaborative registered party management
    match /customers/{customerId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn()
        && isValidId(customerId)
        && incoming().id == customerId
        && isValidCustomer(incoming());

      allow update: if isSignedIn()
        && isValidId(customerId)
        && incoming().id == existing().id
        && isValidCustomer(incoming());

      allow delete: if isSignedIn()
        && isValidId(customerId);
    }

    // 1. Shared Stock Items collection: Full collaborative CRUD for all verified team members/clients
    match /stock_items/{itemId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn()
        && isValidId(itemId)
        && incoming().id == itemId
        && isValidStockItem(incoming());

      allow update: if isSignedIn()
        && isValidId(itemId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && isValidStockItem(incoming());

      allow delete: if isSignedIn()
        && isValidId(itemId);
    }

    // 2. Shared Stock Units collection
    match /stock_units/{unitId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn()
        && isValidId(unitId)
        && incoming().id == unitId
        && isValidStockUnit(incoming());

      allow update: if isSignedIn()
        && isValidId(unitId)
        && incoming().id == existing().id
        && isValidStockUnit(incoming());

      allow delete: if isSignedIn()
        && isValidId(unitId);
    }

    // 2b. Shared Stock Tags collection: Collaborative tags styling & organization
    match /stock_tags/{tagId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn()
        && isValidId(tagId)
        && incoming().id == tagId
        && isValidStockTag(incoming());

      allow update: if isSignedIn()
        && isValidId(tagId)
        && incoming().id == existing().id
        && isValidStockTag(incoming());

      allow delete: if isSignedIn()
        && isValidId(tagId);
    }

    // Legacy stock_labels collection support
    match /stock_labels/{labelId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn()
        && isValidId(labelId)
        && incoming().id == labelId
        && isValidStockLabel(incoming());

      allow update: if isSignedIn()
        && isValidId(labelId)
        && incoming().id == existing().id
        && isValidStockLabel(incoming());

      allow delete: if isSignedIn()
        && isValidId(labelId);
    }

    // 3. Shared Tamper-Proof Audit Logs collection: append-only and sync-safe
    match /audit_logs/{logId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn()
        && isValidId(logId)
        && incoming().id == logId
        && isValidAuditLog(incoming());

      // Allow idempotent sync/update so background synchronization never throws permission errors
      allow update: if isSignedIn()
        && isValidId(logId)
        && incoming().id == logId
        && isValidAuditLog(incoming());

      // Audit logs deletion is strictly forbidden: no user can erase history
      allow delete: if false;
    }

    // 4. User Settings collection
    match /user_settings/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId)
        && isValidId(userId)
        && incoming().userId == userId
        && isValidUserSetting(incoming());

      allow update: if isOwner(userId)
        && isValidId(userId)
        && incoming().userId == userId
        && isValidUserSetting(incoming());

      allow delete: if isOwner(userId);
    }
  }
}

