{
  "entities": {
    "StockItem": {
      "title": "Stock Item",
      "description": "An inventory item tracked in the collaborative stock management system",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "itemName": { "type": "string", "maxLength": 200 },
        "unit": { "type": "string", "maxLength": 50 },
        "quantity": { "type": "number" },
        "lowStockThreshold": { "type": "number" },
        "productionDate": { "type": "string", "maxLength": 30 },
        "notes": { "type": "string", "maxLength": 2000 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdByName": { "type": "string", "maxLength": 100 },
        "createdByEmail": { "type": "string", "maxLength": 100 },
        "lastModifiedByName": { "type": "string", "maxLength": 100 },
        "lastModifiedByEmail": { "type": "string", "maxLength": 100 }
      },
      "required": [
        "id",
        "itemName",
        "unit",
        "quantity",
        "lowStockThreshold",
        "createdAt",
        "updatedAt"
      ]
    },
    "StockUnit": {
      "title": "Stock Unit",
      "description": "Custom measurement unit for stock items",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 50 },
        "code": { "type": "string", "maxLength": 20 },
        "isDefault": { "type": "boolean" },
        "userId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "name"]
    },
    "StockTag": {
      "title": "Stock Tag",
      "description": "Custom category tag with color styling preset for organizing stock inventory",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 60 },
        "color": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 200 },
        "isDefault": { "type": "boolean" },
        "userId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "name"]
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "Activity log entry for stock changes with actor attribution",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "maxLength": 50 },
        "action": { "type": "string", "maxLength": 50 },
        "summary": { "type": "string", "maxLength": 200 },
        "details": { "type": "string", "maxLength": 2000 },
        "itemId": { "type": "string", "maxLength": 128 },
        "itemName": { "type": "string", "maxLength": 200 },
        "unit": { "type": "string", "maxLength": 50 },
        "previousQuantity": { "type": "number" },
        "newQuantity": { "type": "number" },
        "delta": { "type": "number" },
        "performedBy": { "type": "string", "maxLength": 100 },
        "userEmail": { "type": "string", "maxLength": 100 },
        "userPhotoURL": { "type": "string", "maxLength": 500 },
        "userId": { "type": "string", "maxLength": 128 }
      },
      "required": [
        "id",
        "timestamp",
        "action",
        "summary",
        "itemId",
        "itemName",
        "unit",
        "performedBy"
      ]
    },
    "UserSetting": {
      "title": "User Setting",
      "description": "User preferences such as delete confirmation mode and active operator profile",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "confirmOnDelete": { "type": "boolean" },
        "operatorName": { "type": "string", "maxLength": 100 },
        "activeCompanyId": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "confirmOnDelete"]
    },
    "CompanyProfile": {
      "title": "Company Profile",
      "description": "Multi-company profile configuration containing branding, code, currency, and address",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "code": { "type": "string", "maxLength": 30 },
        "tagline": { "type": "string", "maxLength": 300 },
        "currency": { "type": "string", "maxLength": 20 },
        "taxId": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 300 },
        "color": { "type": "string", "maxLength": 50 },
        "isDefault": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 },
        "userId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "name", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/companies/{companyId}": {
      "schema": { "$ref": "#/entities/CompanyProfile" },
      "description": "Multi-company profiles collection for corporate inventory management"
    },
    "/stock_items/{itemId}": {
      "schema": { "$ref": "#/entities/StockItem" },
      "description": "Shared collaborative inventory stock items collection with modification attribution"
    },
    "/stock_units/{unitId}": {
      "schema": { "$ref": "#/entities/StockUnit" },
      "description": "Shared measurement units collection"
    },
    "/stock_tags/{tagId}": {
      "schema": { "$ref": "#/entities/StockTag" },
      "description": "Shared stock tags and categories collection with color styling"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Tamper-proof inventory activity and audit trail collection with actor attribution"
    },
    "/user_settings/{userId}": {
      "schema": { "$ref": "#/entities/UserSetting" },
      "description": "Per-user application preferences and operator settings"
    }
  }
}
